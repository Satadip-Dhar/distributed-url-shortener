# Copy to .env before running `docker compose up`.
# docker-compose.yml uses POSTGRES_PASSWORD; docker-compose.prod.yml also uses
# the image overrides below.

# PostgreSQL superuser password (also used by the backend connections)
POSTGRES_PASSWORD=postgres

# Production images (published by the GitHub Actions pipeline to GHCR)
# Replace "your-username" with your GitHub username / org.
BACKEND_IMAGE=ghcr.io/your-username/p1-url-shortener/backend:latest
FRONTEND_IMAGE=ghcr.io/your-username/p1-url-shortener/frontend:latest
